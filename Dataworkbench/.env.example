# Copy values into the environment of the process that starts the Studio.
# Do not commit a populated .env file or any secret values.
AZURE_OPENAI_REPORTING_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_REPORTING_KEY=
AZURE_OPENAI_REPORTING_MODEL=gpt-5.6-terra
SIT_ANALYSIS_MODEL=gpt-5.6-luna

# Keep live Graph mutations disabled until dry runs have been reviewed.
DLP_STUDIO_LIVE_APPLY=false
SIT_SENSITIVE_CONTENT_ENABLED=false
